{
  "mcpServers": {
    "kschlint": {
      "command": "C:/Path/To/python.exe",
      "args": ["-m", "kschlint", "mcp"],
      "env": { "PYTHONPATH": "C:/path/to/your-project/tools/kicad-sch-lint" }
    },
    "konnect": {
      "command": "C:/Users/YOU/Documents/KiCad/10.0/3rdparty/plugins/com_github_mixelpixx_konnect/bin/konnect.exe"
    }
  }
}
